// MXERP - modelo de dados
// Convenções: quantidades Decimal(14,4), valores Decimal(14,2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Empresa e usuários ─────────────────────────

model Empresa {
  id                  String           @id @default(cuid())
  razaoSocial         String
  nomeFantasia        String?
  cnpj                String           @unique
  inscricaoEstadual   String?
  inscricaoMunicipal  String?
  regimeTributario    RegimeTributario @default(SIMPLES_NACIONAL)
  logradouro          String?
  complemento         String?
  numero              String?
  bairro              String?
  cidade              String?
  codigoMunicipio     String? // IBGE
  uf                  String?          @db.Char(2)
  cep                 String?
  telefone            String?
  email               String?
  ambienteFiscal      AmbienteFiscal   @default(HOMOLOGACAO)
  cnae                String?
  serieNfe            Int              @default(1)
  serieNfce           Int              @default(1)
  cscId               String? // identificador do CSC da NFC-e (ex.: 000001)
  cscToken            String? // CSC gerado no portal da SEFAZ
  ibsCbsAtivo         Boolean          @default(false) // emitir grupo IBS/CBS (reforma tributária)
  ativa               Boolean          @default(true)
  // certificado A1 desta empresa (cada CNPJ tem o seu): .pfx e senha cifrados com a CHAVE_SEGREDOS do servidor
  certificadoPfx      String?
  certificadoSenha    String?
  certificadoValidade DateTime?
  certificadoTitular  String?
  // NFS-e (padrão nacional)
  ambienteNfse        AmbienteFiscal   @default(HOMOLOGACAO)
  serieDps            Int              @default(1)
  regimeEspecialNfse  Int              @default(0) // regEspTrib da DPS: 0 nenhum, 1 ato cooperado, 2 estimativa, 3 ME municipal, 4 notário, 5 autônomo, 6 sociedade de profissionais
  infCplNfe           String? // informações complementares padrão da NF-e/NFC-e
  infCplNfse          String? // texto padrão acrescentado na descrição da NFS-e
  logo                Bytes? // logo da loja (PNG ou JPG) para o DANFE e os impressos
  logoTipo            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO_SUBLIMITE
  REGIME_NORMAL
  MEI
}

enum AmbienteFiscal {
  PRODUCAO
  HOMOLOGACAO
}

/**
 * Usuário do sistema = funcionário do Gestão Click (só entra quem tem acessoSistema e senha).
 */
model Usuario {
  id                String            @id @default(cuid())
  nome              String
  email             String?           @unique
  senhaHash         String?
  papel             PapelUsuario      @default(OPERADOR)
  ativo             Boolean           @default(true)
  acessoSistema     Boolean           @default(true)
  tecnico           Boolean           @default(false)
  vendedor          Boolean           @default(false)
  cpf               String?
  rg                String?
  nascimento        DateTime?         @db.Date
  sexo              String? // M / F
  observacoes       String?
  comissao          Decimal?          @db.Decimal(6, 2)
  salario           Decimal?          @db.Decimal(14, 2) // salário combinado (referência da folha na conciliação)
  liberacaoComissao LiberacaoComissao @default(PARCIAL)
  telefone          String?
  celular           String?
  celular2          String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  codigoMunicipio   String?
  uf                String?           @db.Char(2)
  foto              Bytes?
  fotoTipo          String?
  lojas             String[] // ids de Empresa com acesso
  preferencias      Json? // colunas escolhidas nas listagens etc.
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  osComoTecnico       OrdemServico[]     @relation("OsTecnico")
  osComoVendedor      OrdemServico[]     @relation("OsVendedor")
  orcamentos          Orcamento[]        @relation("OrcamentoVendedor")
  vendas              Venda[]
  movimentos          MovimentoEstoque[]
  sessoes             Sessao[]
  pagamentosRecebidos Lancamento[]       @relation("LancamentoFuncionario")
  caixas              CaixaPdv[]
  caixasFechados      CaixaPdv[]          @relation("CaixaFechadoPor")
  clientesVendedor    Pessoa[]           @relation("PessoaVendedor")
  contratos           Contrato[]
  pessoasCriadas      Pessoa[]           @relation("PessoaCriadoPor")
  anotacoes           PessoaAnotacao[]
  movimentosCaixa     MovimentoCaixa[]
  chamadosResponsavel Chamado[]          @relation("ChamadoResponsavel")
  chamadosAbertos     Chamado[]          @relation("ChamadoAbertoPor")
}

enum LiberacaoComissao {
  GERADO_FINANCEIRO // integral, assim que for gerado financeiro
  PRIMEIRA_PARCELA // integral, quando o cliente pagar a 1ª parcela
  ULTIMA_PARCELA // integral, quando o cliente pagar a última parcela
  PARCIAL // parcial, conforme o recebimento das parcelas
}

/**
 * Sessão de login: o cookie guarda um token aleatório; aqui fica só o hash dele.
 */
model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  ip        String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

/// Sessão do cliente na Área do Cliente (separada da sessão dos funcionários).
model SessaoCliente {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  expira    DateTime
  ip        String?
  createdAt DateTime @default(now())

  @@index([pessoaId])
}

enum PapelUsuario {
  ADMIN
  GERENTE
  OPERADOR
  TECNICO
  CAIXA
}

// ───────────────────────── Cadastros ─────────────────────────

/**
 * Cliente, fornecedor e transportadora (uma pessoa pode ter os três papéis).
 */
model Pessoa {
  id                   String           @id @default(cuid())
  lojas                String[]         @default([]) // empresas em que o cadastro aparece (vazio = todas do grupo)
  codigoCliente        Int?             @unique // nº mostrado como "Cliente #237"
  codigoFornecedor     Int?             @unique
  codigoTransportadora Int?             @unique
  tipoPessoa           TipoPessoa       @default(JURIDICA)
  nome                 String // razão social ou nome completo
  fantasia             String?
  nomeSocial           String?
  documento            String?          @unique // CPF/CNPJ só dígitos
  rg                   String?
  nascimento           DateTime?        @db.Date
  inscricaoEstadual    String? // "ISENTO" quando marcado isento
  inscricaoMunicipal   String?
  suframa              String?
  responsavel          String?
  contribuinteIcms     ContribuinteIcms @default(NAO_CONTRIBUINTE)
  email                String?
  telefone             String?
  celular              String?
  fax                  String?
  site                 String?
  pais                 String           @default("Brasil")
  // endereço principal (usado nas notas); a lista completa fica em enderecos
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  codigoMunicipio      String?
  uf                   String?          @db.Char(2)
  cep                  String?
  cliente              Boolean          @default(true)
  fornecedor           Boolean          @default(false)
  transportadora       Boolean          @default(false)
  ativo                Boolean          @default(true)
  observacoes          String?
  vendedorId           String?
  vendedor             Usuario?         @relation("PessoaVendedor", fields: [vendedorId], references: [id])
  limiteCredito        Decimal?         @db.Decimal(14, 2) // vazio = sem limite
  excederLimite        Boolean          @default(false)
  areaCliente          Boolean          @default(false)
  // Área do Cliente (portal /area-cliente): senha própria do cliente e link de convite/troca de senha (só o hash)
  portalSenhaHash      String?
  portalConviteHash    String?          @unique
  portalConviteExpira  DateTime?
  portalUltimoAcesso   DateTime?
  foto                 Bytes?
  fotoTipo             String?
  camposExtras         Json? // { [CampoExtra.id]: valor }
  idLegado             String?          @unique // id no sistema anterior (migração)
  criadoPorId          String?
  criadoPor            Usuario?         @relation("PessoaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  enderecos       PessoaEndereco[]
  itensFornecidos ItemFornecedor[]
  contatos        PessoaContato[]
  anotacoes       PessoaAnotacao[]
  ordensServico   OrdemServico[]
  orcamentos      Orcamento[]         @relation("OrcamentoCliente")
  orcamentosFrete Orcamento[]         @relation("OrcamentoTransportadora")
  vendasFrete     Venda[]             @relation("VendaTransportadora")
  osFrete         OrdemServico[]      @relation("OsTransportadora")
  comprasFrete    Compra[]            @relation("CompraTransportadora")
  cotacoes        CotacaoFornecedor[] @relation("CotacaoFornecedor")
  vendas          Venda[]
  lancamentos     Lancamento[]
  compras         Compra[]
  contratos       Contrato[]
  chamados        Chamado[]
  sessoesPortal   SessaoCliente[]

  @@index([nome])
}

enum TipoPessoa {
  FISICA
  JURIDICA
  ESTRANGEIRO
}

model PessoaEndereco {
  id              String  @id @default(cuid())
  pessoaId        String
  pessoa          Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  ordem           Int     @default(0)
  tipo            String? // Comercial / Residencial / Entrega (Tipos de endereços)
  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  codigoMunicipio String?
  uf              String? @db.Char(2)

  @@index([pessoaId])
}

model PessoaContato {
  id         String  @id @default(cuid())
  pessoaId   String
  pessoa     Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  ordem      Int     @default(0)
  tipo       String? // Telefone / E-mail / WhatsApp… (Tipos de contatos)
  nome       String?
  contato    String?
  cargo      String?
  observacao String?

  @@index([pessoaId])
}

model PessoaAnotacao {
  id        String   @id @default(cuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  texto     String
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())

  @@index([pessoaId])
}

/**
 * Arquivo anexado a qualquer cadastro ou documento (cliente, funcionário, OS…).
 */
model Anexo {
  id         String   @id @default(cuid())
  entidade   String // PESSOA, USUARIO, OS, FOTO_PRODUTO, FOTO_SERVICO…
  ordem      Int      @default(0)
  entidadeId String
  nome       String
  tipo       String
  tamanho    Int
  dados      Bytes
  usuarioId  String?
  /// item da OS a que a foto se refere (fotos de instalação: entidade OS_FOTO)
  referencia String?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
}

model TipoContato {
  id   String @id @default(cuid())
  nome String @unique
}

model TipoEndereco {
  id   String @id @default(cuid())
  nome String @unique
}

enum TipoCampoExtra {
  TEXTO
  NUMEROS
  DATA
  CPF
  CNPJ
  SELECAO_UNICA
  MULTIPLA_SELECAO
}

/**
 * Campo extra do cadastro (ex.: campos extras de clientes).
 */
model CampoExtra {
  id          String         @id @default(cuid())
  empresaId   String         @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  entidade    String         @default("CLIENTE")
  nome        String
  tipo        TipoCampoExtra @default(TEXTO)
  opcoes      String[]
  obrigatorio Boolean        @default(false)
  ordem       Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([empresaId])
}

enum ContribuinteIcms {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

model GrupoProduto {
  id       String         @id @default(cuid())
  nome     String         @unique
  paiId    String?
  pai      GrupoProduto?  @relation("Subgrupos", fields: [paiId], references: [id])
  filhos   GrupoProduto[] @relation("Subgrupos")
  produtos Produto[]
}

/**
 * Unidades de produtos (UN, CX, MT…).
 */
model Unidade {
  id     String  @id @default(cuid())
  nome   String
  sigla  String  @unique
  padrao Boolean @default(false)
}

/**
 * Tipos de valor de venda (tabela de preços): Varejo, Atacado…
 */
model TipoValor {
  id        String         @id @default(cuid())
  nome      String         @unique
  lucro     Decimal        @default(0) @db.Decimal(14, 4) // % de lucro sobre o custo final
  porRegras Boolean        @default(false) // forma de utilização: ilimitada ou através de regras
  padrao    Boolean        @default(false) // o valor padrão vai para Produto.precoVenda
  lojas     String[]
  valores   ProdutoValor[]
}

model ProdutoValor {
  id             String    @id @default(cuid())
  produtoId      String
  produto        Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipoValorId    String
  tipoValor      TipoValor @relation(fields: [tipoValorId], references: [id])
  lucroUtilizado Decimal   @default(0) @db.Decimal(14, 4)
  valor          Decimal   @default(0) @db.Decimal(14, 2)
  ativo          Boolean   @default(true)

  @@unique([produtoId, tipoValorId])
}

/**
 * Kit: componentes de um produto com composição.
 */
model ProdutoComponente {
  id           String  @id @default(cuid())
  produtoId    String
  produto      Produto @relation("Kit", fields: [produtoId], references: [id], onDelete: Cascade)
  componenteId String
  componente   Produto @relation("ComponenteDe", fields: [componenteId], references: [id])
  quantidade   Decimal @db.Decimal(14, 4)

  @@index([produtoId])
}

/**
 * Variações (grade) do produto: ex. Cor Preta / Tamanho M.
 */
model ProdutoVariacao {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ordem     Int     @default(0)
  nome      String
  codigo    String?
  gtin      String?

  @@index([produtoId])
}

/**
 * Fornecedores que fornecem um produto ou prestam um serviço.
 */
model ItemFornecedor {
  id           String   @id @default(cuid())
  produtoId    String?
  produto      Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  servicoId    String?
  servico      Servico? @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  fornecedorId String
  fornecedor   Pessoa   @relation(fields: [fornecedorId], references: [id])
  codigo       String? // código do produto no fornecedor

  @@index([produtoId])
  @@index([servicoId])
  @@index([fornecedorId])
}

/**
 * Histórico de valores do produto (custo e venda).
 */
model HistoricoValor {
  id        String   @id @default(cuid())
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  campo     String // "Valor de custo", "Varejo"…
  anterior  Decimal  @db.Decimal(14, 4)
  novo      Decimal  @db.Decimal(14, 4)
  usuarioId String?
  createdAt DateTime @default(now())

  @@index([produtoId, createdAt])
}

/**
 * Grades de variações (Cor, Tamanho…).
 */
model Grade {
  id        String   @id @default(cuid())
  nome      String   @unique
  variacoes String[]
}

/**
 * Modelos de etiqueta (PIMACO, Argox…). Medidas em cm.
 */
model ModeloEtiqueta {
  id             String  @id @default(cuid())
  nome           String
  padrao         String  @default("Personalizado")
  altura         Decimal @db.Decimal(6, 2)
  largura        Decimal @db.Decimal(6, 2)
  pagina         String  @default("A4")
  colunas        Int
  linhas         Int
  margemSuperior Decimal @db.Decimal(6, 2)
  margemLateral  Decimal @db.Decimal(6, 2)
  distVertical   Decimal @db.Decimal(6, 2)
  distHorizontal Decimal @db.Decimal(6, 2)
  mostrarNome    Boolean @default(true)
  mostrarPreco   Boolean @default(true)
  mostrarCodigo  Boolean @default(true)
  mostrarBarras  Boolean @default(true)
}

model Produto {
  id                   String        @id @default(cuid())
  codigo               String        @unique
  gtin                 String?
  nome                 String
  unidade              String        @default("UN")
  grupoId              String?
  grupo                GrupoProduto? @relation(fields: [grupoId], references: [id])
  precoVenda           Decimal       @default(0) @db.Decimal(14, 2)
  custo                Decimal       @default(0) @db.Decimal(14, 4)
  controlaEstoque      Boolean       @default(true) // "Movimenta estoque?"
  emiteNota            Boolean       @default(true) // "Habilitar nota fiscal?"
  possuiVariacoes      Boolean       @default(false)
  possuiComposicao     Boolean       @default(false)
  // unidade: compra em unidadeCompra e vende em unidade; 1 unidadeCompra = fatorConversao × unidade
  unidadeCompra        String?
  fatorConversao       Decimal       @default(1) @db.Decimal(14, 4)
  vendidoSeparadamente Boolean       @default(true)
  vendePdv             Boolean       @default(true)
  comissao             Decimal?      @db.Decimal(6, 2)
  camposExtras         Json?
  peso                 Decimal?      @db.Decimal(14, 4)
  largura              Decimal?      @db.Decimal(14, 4)
  altura               Decimal?      @db.Decimal(14, 4)
  comprimento          Decimal?      @db.Decimal(14, 4)
  descricao            String?
  despesasAcessorias   Decimal       @default(0) @db.Decimal(14, 4)
  outrasDespesas       Decimal       @default(0) @db.Decimal(14, 4)
  estoqueMinimo        Decimal       @default(0) @db.Decimal(14, 4)
  estoqueMaximo        Decimal?      @db.Decimal(14, 4)
  codigoBeneficio      String?
  pesoLiquido          Decimal?      @db.Decimal(14, 4)
  pesoBruto            Decimal?      @db.Decimal(14, 4)
  numeroFci            String?
  produtoEspecifico    String?
  lojas                String[]      @default([]) // empresas em que aparece (vazio = todas)
  criadoPorId          String?
  localPadraoId        String? // onde o item "mora"; usado para entradas
  localPadrao          Local?        @relation("LocalPadrao", fields: [localPadraoId], references: [id])
  // fiscal
  ncm                  String?
  cest                 String?
  origem               Int           @default(0)
  cfopInterno          String?
  cfopExterno          String?
  csosn                String?
  cstIcms              String?
  aliquotaIcms         Decimal?      @db.Decimal(7, 4)
  cstPis               String?
  cstCofins            String?
  cClassTrib           String? // IBS/CBS (reforma tributária)
  ativo                Boolean       @default(true)
  idLegado             String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  saldos              Saldo[]
  reservas            Reserva[]
  movimentos          MovimentoEstoque[]
  itensOs             OsItemProduto[]
  itensVenda          VendaItem[]
  itensOrc            OrcamentoItem[]
  itensCompra         CompraItem[]
  itensAjuste         AjusteEstoqueItem[]
  itensTransferencia  TransferenciaEstoqueItem[]
  itensInventario     InventarioItem[]
  valores             ProdutoValor[]
  componentes         ProdutoComponente[]        @relation("Kit")
  usadoEm             ProdutoComponente[]        @relation("ComponenteDe")
  variacoes           ProdutoVariacao[]
  fornecedores        ItemFornecedor[]
  historico           HistoricoValor[]
  anunciosMarketplace AnuncioMarketplace[]

  @@index([nome])
}

model Servico {
  id                        String   @id @default(cuid())
  codigo                    String   @unique
  nome                      String
  preco                     Decimal  @default(0) @db.Decimal(14, 2)
  custo                     Decimal  @default(0) @db.Decimal(14, 2)
  comissao                  Decimal? @db.Decimal(6, 2)
  descricao                 String?
  camposExtras              Json?
  lojas                     String[] @default([]) // empresas em que aparece (vazio = todas)
  // NFS-e
  atividade                 String? // atividade de serviço escolhida (preenche os códigos)
  codigoLc116               String? // item da lista de serviços da LC 116
  codigoTributacaoMunicipal String?
  codigoTributacaoNacional  String? // cTribNac
  codigoNbs                 String?
  cnae                      String?
  descricaoAtividade        String?
  aliquotaIss               Decimal? @db.Decimal(7, 4)
  aliquotaCofins            Decimal? @db.Decimal(7, 4)
  aliquotaPis               Decimal? @db.Decimal(7, 4)
  aliquotaCsll              Decimal? @db.Decimal(7, 4)
  aliquotaIr                Decimal? @db.Decimal(7, 4)
  aliquotaInss              Decimal? @db.Decimal(7, 4)
  descontarImpostos         Boolean  @default(false)
  descontarDeducoes         Boolean  @default(false)
  construcaoCivil           Boolean  @default(false)
  reterIss                  Boolean  @default(false)
  ativo                     Boolean  @default(true)
  idLegado                  String?  @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  itensOs       OsItemServico[]
  itensCompra   CompraItemServico[]
  itensVenda    VendaItemServico[]
  itensOrc      OrcamentoServico[]
  itensContrato ContratoServico[]
  fornecedores  ItemFornecedor[]
}

// ───────────────────────── Estoque ─────────────────────────

model Deposito {
  id        String   @id @default(cuid())
  empresaId String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  nome      String   @unique
  ativo     Boolean  @default(true)
  locais    Local[]
  /// estoque do carro de uma equipe: não entra no disponível da loja; a OS tira daqui o que estiver "no carro"
  equipeId  String?  @unique
  equipe    Equipe?  @relation(fields: [equipeId], references: [id])
  compras   Compra[]

  @@index([empresaId])
}

/// Endereço físico: depósito > corredor > prateleira > nível.
model Local {
  id         String   @id @default(cuid())
  depositoId String
  deposito   Deposito @relation(fields: [depositoId], references: [id])
  corredor   String?
  prateleira String?
  nivel      String?
  codigo     String   @unique // ex.: "LOJA-A-03-2"
  descricao  String?
  ativo      Boolean  @default(true)

  saldos         Saldo[]
  reservas       Reserva[]
  movimentos     MovimentoEstoque[]
  produtosPadrao Produto[]          @relation("LocalPadrao")
  itensOsOrigem  OsItemProduto[]    @relation("OsItemOrigem")
}

/// Quantidade física de um produto em um local.
model Saldo {
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  localId    String
  local      Local    @relation(fields: [localId], references: [id])
  quantidade Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt  DateTime @updatedAt

  @@id([produtoId, localId])
  @@index([localId])
}

enum OrigemDocumento {
  OS
  VENDA
  COMPRA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCAO
  IMPLANTACAO
  AGRUPAMENTO // título que junta várias contas a receber do mesmo cliente (ver LancamentoAgrupado)
}

enum StatusReserva {
  ATIVA
  BAIXADA // virou saída de estoque
  LIBERADA // cancelada / item removido
}

/// Reserva de um item de documento (OS/venda). Cada linha diz DE ONDE
/// a peça deve ser retirada. localId nulo = quantidade em falta (sem estoque).
model Reserva {
  id           String          @id @default(cuid())
  produtoId    String
  produto      Produto         @relation(fields: [produtoId], references: [id])
  localId      String?
  local        Local?          @relation(fields: [localId], references: [id])
  quantidade   Decimal         @db.Decimal(14, 4)
  origemTipo   OrigemDocumento
  origemId     String // id do documento (OS, venda)
  origemItemId String // id do item do documento
  status       StatusReserva   @default(ATIVA)
  separado     Boolean         @default(false) // já foi pego na prateleira
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([produtoId, status])
  @@index([origemTipo, origemId])
  @@index([origemItemId])
}

enum TipoMovimento {
  ENTRADA
  SAIDA
}

/// Livro-razão do estoque: toda alteração de saldo gera um movimento.
model MovimentoEstoque {
  id         String          @id @default(cuid())
  produtoId  String
  produto    Produto         @relation(fields: [produtoId], references: [id])
  localId    String
  local      Local           @relation(fields: [localId], references: [id])
  tipo       TipoMovimento
  quantidade Decimal         @db.Decimal(14, 4) // sempre positiva
  custoUnit  Decimal?        @db.Decimal(14, 4)
  origemTipo OrigemDocumento
  origemId   String?
  observacao String?
  usuarioId  String?
  usuario    Usuario?        @relation(fields: [usuarioId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([produtoId, createdAt])
  @@index([origemTipo, origemId])
}

// ───────────────────────── Ordem de serviço ─────────────────────────

enum SituacaoOs {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  AGUARDANDO_APROVACAO
  CONCLUIDA // serviço feito: baixa estoque
  FATURADA // gerou financeiro/nota
  CANCELADA // libera reservas
  DEVOLVIDA_SEM_REPARO
}

enum PrioridadeOs {
  BAIXA
  MEDIA
  ALTA
  URGENTE
  MUITO_URGENTE
}

/**
 * Equipamentos da OS (uma OS pode ter vários, como no Gestão Click).
 */
model OsEquipamento {
  id          String       @id @default(cuid())
  osId        String
  os          OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  ordem       Int          @default(1)
  equipamento String
  marca       String?
  modelo      String?
  serie       String?
  condicoes   String?
  defeitos    String?
  acessorios  String?
  solucao     String?
  laudo       String?
  garantia    String?

  @@index([osId])
}

model OrdemServico {
  id                String        @id @default(cuid())
  empresaId         String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero            Int           @unique
  clienteId         String
  cliente           Pessoa        @relation(fields: [clienteId], references: [id])
  tecnicoId         String?
  tecnico           Usuario?      @relation("OsTecnico", fields: [tecnicoId], references: [id])
  vendedorId        String?
  vendedor          Usuario?      @relation("OsVendedor", fields: [vendedorId], references: [id])
  situacao          SituacaoOs    @default(ABERTA)
  entrada           DateTime      @default(now())
  previsao          DateTime?
  saida             DateTime?
  prioridade        PrioridadeOs?
  canal             String        @default("Presencial")
  observacoes       String?
  observacaoInterna String?
  desconto          Decimal       @default(0) @db.Decimal(14, 2)
  frete             Decimal       @default(0) @db.Decimal(14, 2)
  outros            Decimal       @default(0) @db.Decimal(14, 2)
  totalProdutos     Decimal       @default(0) @db.Decimal(14, 2)
  totalServicos     Decimal       @default(0) @db.Decimal(14, 2)
  total             Decimal       @default(0) @db.Decimal(14, 2)
  idLegado          String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // padrão Gestão Click: situação configurável, vários técnicos, entrega e pagamento
  situacaoId         String?
  situacaoCfg        SituacaoOsConfig? @relation(fields: [situacaoId], references: [id])
  tecnicoIds         String[]
  centroCusto        String?
  transportadoraId   String?
  transportadora     Pessoa?           @relation("OsTransportadora", fields: [transportadoraId], references: [id])
  mostrarEntrega     Boolean           @default(false)
  enderecoEntregaId  String?
  descontoPercentual Decimal?          @db.Decimal(7, 4)
  exibirTotal        Boolean           @default(true)
  condicao           String            @default("AVISTA") // AVISTA | PARCELADO
  formaPagamentoId   String?
  formaPagamento     FormaPagamento?   @relation("OsForma", fields: [formaPagamentoId], references: [id])
  intervaloDias      Int               @default(30)
  camposExtras       Json              @default("{}")
  token              String            @unique @default(cuid()) // link de cobrança
  criadoPorId        String?
  // equipe de técnicos: todos os membros veem a OS na tela do técnico e podem lançar itens
  equipeId           String?
  equipe             Equipe?           @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  equipamentos         OsEquipamento[]
  produtos             OsItemProduto[]
  servicos             OsItemServico[]
  historico            OsHistorico[]
  parcelas             OsParcela[]
  chamados             Chamado[]
  trabalho             OsTrabalho[]
  /// o técnico apertou "Finalizar trabalho" (tempo de mão de obra fechado); "Retomar" limpa
  trabalhoFinalizadoEm DateTime?

  // agendamento da visita/serviço (Agenda das equipes e Google Agenda)
  agendaInicio     DateTime?
  agendaDuracaoMin Int?
  googleEventoId   String? // evento criado no Google Agenda
  googleAgendaId   String? // agenda (calendário) onde o evento está
  googleSincEm     DateTime?
  googleErro       String?
  googlePendente   Boolean   @default(false) // a última tentativa falhou: o agendador tenta de novo

  /// OS cancelada porque foi juntada com outras do mesmo cliente nesta OS
  juntadaEmId String?
  juntadaEm   OrdemServico?  @relation("OsJuncao", fields: [juntadaEmId], references: [id], onDelete: SetNull)
  juntadas    OrdemServico[] @relation("OsJuncao")

  @@index([situacao])
  @@index([clienteId])
  @@index([empresaId])
  @@index([equipeId])
  @@index([agendaInicio])
}

/// Equipe de técnicos (Cadastros › Equipes). A OS da equipe aparece para todos os membros na tela do técnico.
model Equipe {
  id             String         @id @default(cuid())
  nome           String         @unique
  ativo          Boolean        @default(true)
  membros        String[] // ids de Usuario
  /// ID da agenda do Google da equipe (compartilhada com a conta de serviço do ERP)
  googleAgendaId String?
  createdAt      DateTime       @default(now())
  ordens         OrdemServico[]
  /// o carro da equipe (estoque à parte)
  carro          Deposito?
}

model OsItemProduto {
  id             String       @id @default(cuid())
  osId           String
  os             OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto      @relation(fields: [produtoId], references: [id])
  quantidade     Decimal      @db.Decimal(14, 4)
  valorUnit      Decimal      @db.Decimal(14, 2)
  custoUnit      Decimal      @default(0) @db.Decimal(14, 4)
  desconto       Decimal      @default(0) @db.Decimal(14, 2)
  subtotal       Decimal      @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  ordem          Int          @default(0)
  detalhes       String?
  tipoValorId    String?
  // tela do técnico: quem lançou o item e se já foi instalado/feito
  criadoPorId    String?
  instalado      Boolean      @default(false)
  instaladoEm    DateTime?
  instaladoPorId String?
  // "no carro": a peça sai deste local (o carro da equipe) em vez do estoque da loja
  localOrigemId  String?
  localOrigem    Local?       @relation("OsItemOrigem", fields: [localOrigemId], references: [id], onDelete: SetNull)
}

model OsItemServico {
  id             String       @id @default(cuid())
  osId           String
  os             OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  servicoId      String
  servico        Servico      @relation(fields: [servicoId], references: [id])
  quantidade     Decimal      @default(1) @db.Decimal(14, 4)
  valorUnit      Decimal      @db.Decimal(14, 2)
  desconto       Decimal      @default(0) @db.Decimal(14, 2)
  subtotal       Decimal      @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  ordem          Int          @default(0)
  detalhes       String?
  // tela do técnico: quem lançou o item e se já foi instalado/feito
  criadoPorId    String?
  instalado      Boolean      @default(false)
  instaladoEm    DateTime?
  instaladoPorId String?
}

/// Situação de OS configurável (Opções auxiliares › Situações), como no Gestão Click.
model SituacaoOsConfig {
  id               String          @id @default(cuid())
  empresaId        String          @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome             String
  cor              String          @default("cinza")
  ordem            Int             @default(0)
  padrao           Boolean         @default(false)
  permiteEdicao    Boolean         @default(true)
  exibir           Boolean         @default(true)
  exibirCobranca   Boolean         @default(true)
  estoque          EstoqueSituacao @default(RESERVAR)
  financeiro       Boolean         @default(false)
  notaServico      NotaSituacao    @default(NAO)
  enviarMensagem   Boolean         @default(false)
  modeloMensagemId String?
  gerarAssinatura  Boolean         @default(false)
  preencherSaida   Boolean         @default(false)
  bloqueados       PapelUsuario[]
  ordens           OrdemServico[]

  @@unique([empresaId, nome])
}

model OsParcela {
  id               String          @id @default(cuid())
  osId             String
  os               OrdemServico    @relation(fields: [osId], references: [id], onDelete: Cascade)
  numero           Int
  vencimento       DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  observacao       String?

  @@index([osId])
}

/// Tempo de mão de obra da OS: cada trecho vai de "Iniciar/Retomar" até "Pausar/Finalizar" na tela do técnico.
model OsTrabalho {
  id            String       @id @default(cuid())
  osId          String
  os            OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  inicio        DateTime     @default(now())
  fim           DateTime?
  /// por que parou: motivo da pausa ou "Finalizado"
  motivo        String?
  iniciadoPor   String
  iniciadoPorId String?
  encerradoPor  String?

  @@index([osId])
}

model OsHistorico {
  id          String       @id @default(cuid())
  osId        String
  os          OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  descricao   String
  situacao    String?
  usuarioNome String?
  usuarioId   String?
  createdAt   DateTime     @default(now())
}

// ───────────────────────── Vendas / PDV ─────────────────────────

enum TipoVenda {
  PEDIDO
  SERVICO // venda de serviços
  BALCAO // PDV
}

/// O que a situação da venda faz com o estoque.
enum EstoqueSituacao {
  RESERVAR // separa as peças (MXERP: o pedido em aberto já reserva)
  LANCAR // baixa do estoque
  NAO // não mexe (libera o que estava reservado)
}

/// O que a situação faz com a nota (NF-e ou NFS-e).
enum NotaSituacao {
  NAO
  GERAR // gera sem emitir
  EMITIR // gera e emite
}

/// Situações configuráveis da venda (Vendas › Opções auxiliares › Situações).
model SituacaoVendaConfig {
  id               String          @id @default(cuid())
  empresaId        String          @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome             String
  cor              String          @default("cinza")
  ordem            Int             @default(0)
  padrao           Boolean         @default(false)
  permiteEdicao    Boolean         @default(true)
  exibir           Boolean         @default(true)
  exibirCobranca   Boolean         @default(true)
  estoque          EstoqueSituacao @default(RESERVAR)
  financeiro       Boolean         @default(false)
  notaProduto      NotaSituacao    @default(NAO)
  notaServico      NotaSituacao    @default(NAO)
  enviarMensagem   Boolean         @default(false)
  modeloMensagemId String?
  gerarAssinatura  Boolean         @default(false)
  bloqueados       PapelUsuario[]
  vendas           Venda[]

  @@unique([empresaId, nome])
}

/// Canais de venda (valem para vendas, orçamentos e OS).
model CanalVenda {
  id        String  @id @default(cuid())
  empresaId String  @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome      String
  padrao    Boolean @default(false)
  ordem     Int     @default(0)

  @@unique([empresaId, nome])
}

enum SituacaoVenda {
  ORCAMENTO // não reserva
  ABERTA // reserva
  CONCLUIDA // baixa estoque + financeiro
  CANCELADA
}

/**
 * Caixa do PDV: aberto com um valor em dinheiro, as vendas de balcão ficam ligadas a ele até o fechamento.
 */
model CaixaPdv {
  id              String           @id @default(cuid())
  empresaId       String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  usuarioId       String
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])
  abertoEm        DateTime         @default(now())
  valorAbertura   Decimal          @db.Decimal(14, 2)
  fechadoEm       DateTime?
  valorFechamento Decimal?         @db.Decimal(14, 2)
  observacao      String?
  /// nº sequencial do caixa (Sequencia CAIXA), mostrado no relatório de caixas
  numero          Int?
  /// dinheiro que devia estar na gaveta no fechamento (abertura + vendas em dinheiro + reforços − sangrias)
  valorEsperado   Decimal?         @db.Decimal(14, 2)
  /// conferência do fechamento por forma de pagamento: [{ forma, esperado, contado }]
  conferencia     Json?
  /// quem fechou (o próprio operador ou um gerente que fechou o caixa esquecido)
  fechadoPorId    String?
  fechadoPor      Usuario?         @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id])
  /// lançamento da sobra/quebra de dinheiro no financeiro (conta Caixa), quando pedido no fechamento
  lancamentoDiferencaId String?
  vendas          Venda[]
  movimentos      MovimentoCaixa[]

  @@index([usuarioId, fechadoEm])
  @@index([empresaId])
  @@index([abertoEm])
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

/// Sangria (retirada de dinheiro da gaveta) ou suprimento (troco colocado) durante o caixa aberto.
model MovimentoCaixa {
  id              String             @id @default(cuid())
  caixaId         String
  caixa           CaixaPdv           @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo            TipoMovimentoCaixa
  valor           Decimal            @db.Decimal(14, 2)
  motivo          String?
  usuarioId       String
  usuario         Usuario            @relation(fields: [usuarioId], references: [id])
  /// transferência no financeiro (Caixa ↔ outra conta), quando informada a conta
  transferenciaId String?
  createdAt       DateTime           @default(now())

  @@index([caixaId])
}

model Venda {
  id          String        @id @default(cuid())
  empresaId   String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero      Int           @unique
  tipo        TipoVenda     @default(PEDIDO)
  clienteId   String?
  cliente     Pessoa?       @relation(fields: [clienteId], references: [id])
  vendedorId  String?
  vendedor    Usuario?      @relation(fields: [vendedorId], references: [id])
  situacao    SituacaoVenda @default(ABERTA)
  data        DateTime      @default(now())
  desconto    Decimal       @default(0) @db.Decimal(14, 2)
  frete       Decimal       @default(0) @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  observacoes String?
  idLegado    String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // campos do pedido completo (padrão Gestão Click)
  situacaoId         String?
  situacaoCfg        SituacaoVendaConfig? @relation(fields: [situacaoId], references: [id])
  prazoEntrega       DateTime?            @db.Date
  canal              String               @default("Presencial")
  centroCusto        String?
  transportadoraId   String?
  transportadora     Pessoa?              @relation("VendaTransportadora", fields: [transportadoraId], references: [id])
  mostrarEntrega     Boolean              @default(false)
  enderecoEntregaId  String?
  totalProdutos      Decimal              @default(0) @db.Decimal(14, 2)
  totalServicos      Decimal              @default(0) @db.Decimal(14, 2)
  descontoPercentual Decimal?             @db.Decimal(7, 4)
  condicao           String               @default("AVISTA") // AVISTA | PARCELADO
  formaPagamentoId   String?
  formaPagamento     FormaPagamento?      @relation("VendaForma", fields: [formaPagamentoId], references: [id])
  intervaloDias      Int                  @default(30)
  observacaoInterna  String?
  camposExtras       Json                 @default("{}")
  token              String               @unique @default(cuid()) // link de cobrança
  criadoPorId        String?

  caixaId String?
  caixa   CaixaPdv? @relation(fields: [caixaId], references: [id])

  // frete cotado no Melhor Envio (serviço escolhido no pedido); a etiqueta comprada fica em EnvioFrete
  freteServicoId   Int?
  freteServicoNome String?
  fretePrazoDias   Int?
  envios           EnvioFrete[]

  itens      VendaItem[]
  servicos   VendaItemServico[]
  pagamentos VendaPagamento[]
  parcelas   VendaParcela[]
  historico  VendaHistorico[]
  devolucoes Devolucao[]

  /// venda cancelada porque foi juntada com outras do mesmo cliente nesta venda
  juntadaEmId String?
  juntadaEm   Venda?  @relation("VendaJuncao", fields: [juntadaEmId], references: [id], onDelete: SetNull)
  juntadas    Venda[] @relation("VendaJuncao")

  @@index([empresaId])
}

model VendaParcela {
  id               String          @id @default(cuid())
  vendaId          String
  venda            Venda           @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  numero           Int
  vencimento       DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  observacao       String?
}

model VendaHistorico {
  id          String   @id @default(cuid())
  vendaId     String
  venda       Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  descricao   String
  situacao    String?
  usuarioNome String?
  createdAt   DateTime @default(now())
}

enum TipoDevolucao {
  DEVOLUCAO
  TROCA
}

/// Trocas e devoluções: os produtos voltam ao estoque; a troca gera vale-compras e a devolução, conta a pagar ao cliente.
model Devolucao {
  id          String          @id @default(cuid())
  empresaId   String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero      Int             @unique
  tipo        TipoDevolucao
  vendaId     String
  venda       Venda           @relation(fields: [vendaId], references: [id])
  clienteId   String?
  total       Decimal         @db.Decimal(14, 2)
  observacao  String?
  usuarioNome String?
  createdAt   DateTime        @default(now())
  itens       DevolucaoItem[]
  vale        ValeCompra?

  @@index([empresaId])
}

model DevolucaoItem {
  id          String    @id @default(cuid())
  devolucaoId String
  devolucao   Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  vendaItemId String
  produtoId   String
  quantidade  Decimal   @db.Decimal(14, 4)
  valorUnit   Decimal   @db.Decimal(14, 2)
  total       Decimal   @db.Decimal(14, 2)
}

model ValeCompra {
  id          String     @id @default(cuid())
  codigo      String     @unique
  clienteId   String?
  devolucaoId String?    @unique
  devolucao   Devolucao? @relation(fields: [devolucaoId], references: [id])
  valor       Decimal    @db.Decimal(14, 2)
  saldo       Decimal    @db.Decimal(14, 2)
  validade    DateTime?  @db.Date
  createdAt   DateTime   @default(now())
}

model VendaItem {
  id          String  @id @default(cuid())
  ordem       Int     @default(0)
  detalhes    String?
  tipoValorId String?
  vendaId     String
  venda       Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId   String
  produto     Produto @relation(fields: [produtoId], references: [id])
  descricao   String? // item avulso: descrição digitada (produto = ITEM-AVULSO)
  quantidade  Decimal @db.Decimal(14, 4)
  valorUnit   Decimal @db.Decimal(14, 2)
  custoUnit   Decimal @default(0) @db.Decimal(14, 4)
  desconto    Decimal @default(0) @db.Decimal(14, 2)
  subtotal    Decimal @db.Decimal(14, 2)
}

model VendaItemServico {
  id         String  @id @default(cuid())
  vendaId    String
  venda      Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  servicoId  String
  servico    Servico @relation(fields: [servicoId], references: [id])
  quantidade Decimal @default(1) @db.Decimal(14, 4)
  valorUnit  Decimal @db.Decimal(14, 2)
  desconto   Decimal @default(0) @db.Decimal(14, 2)
  subtotal   Decimal @db.Decimal(14, 2)
  ordem      Int     @default(0)
  detalhes   String?
}

model VendaPagamento {
  id               String         @id @default(cuid())
  vendaId          String
  venda            Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  formaPagamentoId String
  formaPagamento   FormaPagamento @relation(fields: [formaPagamentoId], references: [id])
  valor            Decimal        @db.Decimal(14, 2)
  parcelas         Int            @default(1)
}

// ───────────────────────── Compras ─────────────────────────

model Compra {
  id           String       @id @default(cuid())
  empresaId    String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero       Int          @unique
  tipo         String       @default("PRODUTO") // PRODUTO | SERVICO (compras de serviços)
  fornecedorId String
  fornecedor   Pessoa       @relation(fields: [fornecedorId], references: [id])
  data         DateTime     @default(now()) @db.Date
  recebida     Boolean      @default(false) // estoque já lançado
  /// estoque (depósito) onde as peças entram; nulo = o padrão das configurações de estoque (nunca o carro)
  depositoId   String?
  deposito     Deposito?    @relation(fields: [depositoId], references: [id])
  chaveNfe     String?
  total        Decimal      @default(0) @db.Decimal(14, 2)
  createdAt    DateTime     @default(now())
  itens        CompraItem[]

  // padrão Gestão Click
  situacaoId         String?
  situacaoCfg        SituacaoCompraConfig? @relation(fields: [situacaoId], references: [id])
  numeroNfe          String?
  centroCusto        String?
  transportadoraId   String?
  transportadora     Pessoa?               @relation("CompraTransportadora", fields: [transportadoraId], references: [id])
  frete              Decimal               @default(0) @db.Decimal(14, 2)
  freteNoTotal       Boolean               @default(true)
  impostos           Decimal               @default(0) @db.Decimal(14, 2)
  impostosNoTotal    Boolean               @default(true)
  desconto           Decimal               @default(0) @db.Decimal(14, 2)
  descontoPercentual Decimal?              @db.Decimal(7, 4)
  totalProdutos      Decimal               @default(0) @db.Decimal(14, 2)
  totalServicos      Decimal               @default(0) @db.Decimal(14, 2)
  condicao           String                @default("AVISTA")
  formaPagamentoId   String?
  formaPagamento     FormaPagamento?       @relation("CompraForma", fields: [formaPagamentoId], references: [id])
  intervaloDias      Int                   @default(30)
  observacoes        String?
  observacaoInterna  String?
  camposExtras       Json                  @default("{}")
  token              String                @unique @default(cuid())
  criadoPorId        String?
  cotacaoId          String?
  idLegado           String?               @unique
  financeiroNoLegado Boolean               @default(false) // migrada já com as contas lançadas no Gestão Click (não lança de novo)
  updatedAt          DateTime              @default(now()) @updatedAt

  servicos  CompraItemServico[]
  parcelas  CompraParcela[]
  historico CompraHistorico[]

  @@index([data])
  @@index([empresaId])
}

model CompraItem {
  id            String  @id @default(cuid())
  compraId      String
  compra        Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  localId       String? // onde vai ser guardado
  // quantidade e custoUnit na unidade da nota (unidadeCompra); no estoque entra quantidade × fator na unidade do produto
  quantidade    Decimal @db.Decimal(14, 4)
  custoUnit     Decimal @db.Decimal(14, 4)
  unidadeCompra String?
  fator         Decimal @default(1) @db.Decimal(14, 4)
  ordem         Int     @default(0)
  detalhes      String?
  desconto      Decimal @default(0) @db.Decimal(14, 2)
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
}

model CompraItemServico {
  id         String  @id @default(cuid())
  compraId   String
  compra     Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  servicoId  String
  servico    Servico @relation(fields: [servicoId], references: [id])
  ordem      Int     @default(0)
  detalhes   String?
  quantidade Decimal @default(1) @db.Decimal(14, 4)
  valorUnit  Decimal @db.Decimal(14, 2)
  desconto   Decimal @default(0) @db.Decimal(14, 2)
  subtotal   Decimal @db.Decimal(14, 2)
}

model CompraParcela {
  id               String          @id @default(cuid())
  compraId         String
  compra           Compra          @relation(fields: [compraId], references: [id], onDelete: Cascade)
  numero           Int
  vencimento       DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  observacao       String?

  @@index([compraId])
}

model CompraHistorico {
  id          String   @id @default(cuid())
  compraId    String
  compra      Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  descricao   String
  situacao    String?
  usuarioNome String?
  usuarioId   String?
  createdAt   DateTime @default(now())
}

/// Situações de compra: o que cada uma lança (estoque e/ou financeiro), como no Gestão Click.
model SituacaoCompraConfig {
  id            String   @id @default(cuid())
  empresaId     String   @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome          String
  cor           String   @default("cinza")
  padrao        Boolean  @default(false)
  exibir        Boolean  @default(true) // aparece na listagem
  lancamento    String   @default("NAO") // NAO | AMBOS | ESTOQUE | FINANCEIRO
  permiteEdicao Boolean  @default(true)
  bloqueados    String[]
  ordem         Int      @default(0)
  compras       Compra[]

  @@index([empresaId])
}

// ───────────────────────── Ajustes, transferências, inventários e cotações ─────────────────────────

model AjusteEstoque {
  id            String              @id @default(cuid())
  empresaId     String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero        Int                 @unique
  tipo          TipoMovimento
  frete         Decimal             @default(0) @db.Decimal(14, 2)
  total         Decimal             @default(0) @db.Decimal(14, 2)
  observacoes   String?
  criadoPorId   String?
  criadoPorNome String?
  inventarioId  String?
  idLegado      String?             @unique
  createdAt     DateTime            @default(now())
  itens         AjusteEstoqueItem[]

  @@index([empresaId])
}

model AjusteEstoqueItem {
  id         String        @id @default(cuid())
  ajusteId   String
  ajuste     AjusteEstoque @relation(fields: [ajusteId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto       @relation(fields: [produtoId], references: [id])
  localId    String?
  quantidade Decimal       @db.Decimal(14, 4)
  custoUnit  Decimal       @default(0) @db.Decimal(14, 4)
  total      Decimal       @default(0) @db.Decimal(14, 2)
  ordem      Int           @default(0)
}

/// Transferência entre depósitos (as "lojas" do Gestão Click).
model TransferenciaEstoque {
  id                String                     @id @default(cuid())
  empresaId         String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero            Int                        @unique
  origemDepositoId  String
  destinoDepositoId String
  total             Decimal                    @default(0) @db.Decimal(14, 2)
  observacoes       String?
  criadoPorId       String?
  criadoPorNome     String?
  createdAt         DateTime                   @default(now())
  itens             TransferenciaEstoqueItem[]

  @@index([empresaId])
}

model TransferenciaEstoqueItem {
  id              String               @id @default(cuid())
  transferenciaId String
  transferencia   TransferenciaEstoque @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  produtoId       String
  produto         Produto              @relation(fields: [produtoId], references: [id])
  quantidade      Decimal              @db.Decimal(14, 4)
  custoUnit       Decimal              @default(0) @db.Decimal(14, 4)
  ordem           Int                  @default(0)
}

model Inventario {
  id                  String           @id @default(cuid())
  empresaId           String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero              Int              @unique
  descricao           String
  responsavelId       String?
  responsavelNome     String
  data                DateTime         @db.Date
  motivo              String?
  escopo              String           @default("TODOS") // TODOS | GRUPOS | FORNECEDORES | PRODUTOS
  filtroIds           String[]
  contagemCega        Boolean          @default(false)
  somarLeituras       Boolean          @default(true)
  considerarMovimento Boolean          @default(true)
  situacao            String           @default("CONTANDO") // CONTANDO | CONCLUIDO | CANCELADO
  concluidoEm         DateTime?
  createdAt           DateTime         @default(now())
  itens               InventarioItem[]

  @@index([empresaId])
}

model InventarioItem {
  id           String     @id @default(cuid())
  inventarioId String
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId    String
  produto      Produto    @relation(fields: [produtoId], references: [id])
  saldoInicial Decimal    @db.Decimal(14, 4) // saldo no início da contagem
  contado      Decimal?   @db.Decimal(14, 4)
  custoUnit    Decimal    @default(0) @db.Decimal(14, 4)

  @@unique([inventarioId, produtoId])
}

model Cotacao {
  id                String              @id @default(cuid())
  empresaId         String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero            Int                 @unique
  data              DateTime            @db.Date
  prazo             DateTime?           @db.Date // prazo para os fornecedores responderem
  observacoes       String? // para o fornecedor
  observacaoInterna String?
  situacao          String              @default("ABERTA") // ABERTA | FINALIZADA | CANCELADA
  compraId          String?
  criadoPorId       String?
  criadoPorNome     String?
  createdAt         DateTime            @default(now())
  fornecedores      CotacaoFornecedor[]
  itens             CotacaoItem[]

  @@index([empresaId])
}

model CotacaoFornecedor {
  id           String            @id @default(cuid())
  cotacaoId    String
  cotacao      Cotacao           @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  fornecedorId String
  fornecedor   Pessoa            @relation("CotacaoFornecedor", fields: [fornecedorId], references: [id])
  email        String
  celular      String?
  token        String            @unique @default(cuid())
  respondidoEm DateTime?
  frete        Decimal?          @db.Decimal(14, 2)
  prazoEntrega String?
  condicao     String?
  observacao   String?
  respostas    CotacaoResposta[]
}

model CotacaoItem {
  id         String            @id @default(cuid())
  cotacaoId  String
  cotacao    Cotacao           @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  produtoId  String?
  servicoId  String?
  nome       String
  detalhes   String?
  quantidade Decimal           @db.Decimal(14, 4)
  unidade    String            @default("UN")
  ordem      Int               @default(0)
  respostas  CotacaoResposta[]
}

model CotacaoResposta {
  id           String            @id @default(cuid())
  fornecedorId String
  fornecedor   CotacaoFornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  itemId       String
  item         CotacaoItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  valorUnit    Decimal?          @db.Decimal(14, 4)
  observacao   String?

  @@unique([fornecedorId, itemId])
}

// ───────────────────────── Financeiro ─────────────────────────

model ContaBancaria {
  id                String              @id @default(cuid())
  empresaId         String              @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome              String
  banco             String?
  agencia           String?
  conta             String?
  saldoInicial      Decimal             @default(0) @db.Decimal(14, 2)
  ativa             Boolean             @default(true)
  lancamentos       Lancamento[]
  transacoes        TransacaoBancaria[]
  integracoesInter  IntegracaoInter[]
  saldos            SaldoBancario[]
  contasOpenFinance ContaOpenFinance[]

  @@unique([empresaId, nome])
}

/// Banco conectado pelo Open Finance (agregador Pluggy): um "item" por banco/consentimento autorizado pelo cliente.
model ConexaoOpenFinance {
  id               String             @id @default(cuid())
  itemId           String             @unique // id do item no Pluggy
  banco            String
  logo             String?
  situacao         String // UPDATED | UPDATING | LOGIN_ERROR | OUTDATED | WAITING_USER_INPUT | ...
  consentimentoAte DateTime? // o consentimento do Open Finance vence (normalmente 12 meses)
  ultimaSincEm     DateTime?
  ultimaSincMsg    String?
  contas           ContaOpenFinance[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/// Conta do banco conectado; ligada a uma conta bancária do ERP, o extrato entra na conciliação como o do Inter.
model ContaOpenFinance {
  id              String             @id @default(cuid())
  conexaoId       String
  conexao         ConexaoOpenFinance @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  accountId       String             @unique // id da conta no Pluggy
  nome            String
  numero          String?
  tipo            String // BANK | CREDIT
  saldo           Decimal?           @db.Decimal(14, 2)
  contaBancariaId String?
  contaBancaria   ContaBancaria?     @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  importarDesde   DateTime?          @db.Date // primeiro dia do extrato que entra na conciliação
  createdAt       DateTime           @default(now())
}

/// Integração com a API PJ do Banco Inter, cadastrada pela tela (uma só, id "inter").
/// Client secret e chave privada ficam cifrados (AES-256-GCM) com a chave do servidor (CHAVE_SEGREDOS ou CRON_SECRET do .env).
/// Uma por empresa (CNPJ): "inter" é a primeira; as outras são "inter-<empresaId>". Cada uma com conta, extrato e boletos próprios.
model IntegracaoInter {
  id                   String         @id @default("inter")
  empresaId            String?        @unique // empresa dona desta conta do Inter (vazio = a principal, antes de ter outra)
  clientId             String
  clientSecretCifrado  String
  certificado          String // PEM do .crt (público)
  chaveCifrada         String // PEM do .key, cifrado
  contaCorrente        String?
  ambiente             String         @default("producao") // producao | sandbox
  escopos              String         @default("extrato.read boleto-cobranca.read boleto-cobranca.write")
  contaBancariaId      String?
  contaBancaria        ContaBancaria? @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  sincronizarAuto      Boolean        @default(true)
  ultimoTesteEm        DateTime?
  ultimoTesteOk        Boolean?
  ultimoTesteMsg       String?
  ultimaSincEm         DateTime?
  ultimaSincMsg        String?
  // boletos (API de Cobrança v3: BolePix)
  emitirBoletos        Boolean        @default(true) // registra o boleto sozinho quando a parcela é de uma forma "boleto Inter"
  boletosDesde         DateTime? // só parcelas lançadas depois disto viram boleto (as antigas/migradas não)
  multaPct             Decimal        @default(2) @db.Decimal(5, 2)
  jurosMesPct          Decimal        @default(1) @db.Decimal(5, 2)
  diasBaixa            Int            @default(30) // dias depois do vencimento em que o Inter cancela o boleto não pago (0 a 60)
  mensagemBoleto       String?
  urlPublica           String? // endereço https do ERP para o webhook do Inter (opcional)
  webhookToken         String?
  webhookMsg           String?
  ultimaSincBoletosEm  DateTime?
  ultimaSincBoletosMsg String?
  atualizadoEm         DateTime       @updatedAt
}

/// Boleto (BolePix) registrado no Banco Inter para uma parcela de contas a receber.
model Boleto {
  id                String      @id @default(cuid())
  lancamentoId      String?
  lancamento        Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  token             String      @unique // link público do PDF
  interId           String? // integração do Inter que registrou (vazio = "inter", a primeira)
  seuNumero         String
  codigoSolicitacao String?     @unique
  // EMITINDO, EM_PROCESSAMENTO, A_RECEBER, ATRASADO, RECEBIDO, MARCADO_RECEBIDO, CANCELADO, EXPIRADO, FALHA_EMISSAO, PROTESTO, ERRO
  situacao          String      @default("EMITINDO")
  valor             Decimal     @db.Decimal(14, 2)
  vencimento        DateTime    @db.Date
  nossoNumero       String?
  linhaDigitavel    String?
  codigoBarras      String?
  txid              String?
  pixCopiaECola     String?
  pdf               Bytes?
  erro              String?
  pagoEm            DateTime?   @db.Date
  valorRecebido     Decimal?    @db.Decimal(14, 2)
  origemRecebimento String? // BOLETO ou PIX
  ambiente          String      @default("producao")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([lancamentoId])
  @@index([interId])
  @@index([situacao])
  @@index([nossoNumero])
  @@index([txid])
}

model FormaPagamento {
  id              String             @id @default(cuid())
  empresaId       String             @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome            String
  tPag            String // código do meio de pagamento na NF-e (01 dinheiro, 03 crédito, 17 PIX...)
  taxa            Decimal            @default(0) @db.Decimal(7, 4)
  diasPrazo       Int                @default(0)
  ativa           Boolean            @default(true)
  boletoInter     Boolean            @default(false) // parcelas desta forma viram boleto registrado no Banco Inter
  pagseguro       Boolean            @default(false) // recebida pelo PagSeguro (maquininha/PIX): conciliada pelo EDI com a taxa real
  contaBancariaId String? // conta onde cai o recebimento à vista (vazio = Caixa)
  pagamentos      VendaPagamento[]
  lancamentos     Lancamento[]
  orcamentos      Orcamento[]
  parcelasOrc     OrcamentoParcela[]
  vendas          Venda[]            @relation("VendaForma")
  parcelasVen     VendaParcela[]
  ordens          OrdemServico[]     @relation("OsForma")
  parcelasOs      OsParcela[]
  compras         Compra[]           @relation("CompraForma")
  parcelasCompra  CompraParcela[]
  contratos       Contrato[]

  @@unique([empresaId, nome])
}

/// Grupo da DRE gerencial para onde a categoria soma.
enum GrupoDre {
  RECEITA_BRUTA
  DEDUCOES // impostos sobre venda, devoluções
  CUSTO // CMV / CSP
  DESPESA_OPERACIONAL
  DESPESA_FINANCEIRA
  RECEITA_FINANCEIRA
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
  NAO_OPERACIONAL // transferências, aportes, retiradas: fora da DRE
}

enum TipoLancamento {
  RECEBER
  PAGAR
}

model CategoriaFinanceira {
  id                String                @id @default(cuid())
  empresaId         String                @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome              String
  tipo              TipoLancamento
  grupoDre          GrupoDre
  codigo            String? // classificação do plano de contas (1, 1.1, 1.1.2…)
  ativa             Boolean               @default(true)
  paiId             String?
  pai               CategoriaFinanceira?  @relation("CategoriaPai", fields: [paiId], references: [id])
  filhas            CategoriaFinanceira[] @relation("CategoriaPai")
  lancamentos       Lancamento[]
  regrasConciliacao RegraConciliacao[]
  rateios           LancamentoRateio[]

  @@unique([empresaId, nome, tipo])
}

model Lancamento {
  id               String              @id @default(cuid())
  empresaId        String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  tipo             TipoLancamento
  descricao        String
  pessoaId         String?
  pessoa           Pessoa?             @relation(fields: [pessoaId], references: [id])
  categoriaId      String
  categoria        CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  contaBancariaId  String?
  contaBancaria    ContaBancaria?      @relation(fields: [contaBancariaId], references: [id])
  formaPagamentoId String?
  formaPagamento   FormaPagamento?     @relation(fields: [formaPagamentoId], references: [id])
  valor            Decimal             @db.Decimal(14, 2)
  vencimento       DateTime            @db.Date
  competencia      DateTime            @db.Date // mês da DRE
  pagoEm           DateTime?           @db.Date
  valorPago        Decimal?            @db.Decimal(14, 2)
  juros            Decimal             @default(0) @db.Decimal(14, 2)
  desconto         Decimal             @default(0) @db.Decimal(14, 2)
  parcela          Int                 @default(1)
  totalParcelas    Int                 @default(1)
  origemTipo       OrigemDocumento?
  origemId         String?
  idLegado         String?             @unique
  // baixa feita pela conciliação do extrato
  transacaoId      String?
  transacao        TransacaoBancaria?  @relation(fields: [transacaoId], references: [id])
  rateio           LancamentoRateio[]
  boletos          Boleto[]
  centroCustoId    String?
  centroCusto      CentroCusto?        @relation(fields: [centroCustoId], references: [id])
  // as duas pernas (saída da origem e entrada no destino) de uma transferência entre contas
  transferenciaId  String?
  observacao       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  avisosBoleto     AvisoBoleto[]
  /// título agrupado (origemTipo AGRUPAMENTO): as contas que ele juntou, com o documento que gerou cada uma
  agrupados        LancamentoAgrupado[]
  // pagamento a funcionário feito pela conciliação (folha e painel de mão de obra)
  funcionarioId    String?
  funcionario      Usuario?            @relation("LancamentoFuncionario", fields: [funcionarioId], references: [id], onDelete: SetNull)

  @@index([tipo, vencimento])
  @@index([competencia])
  @@index([origemTipo, origemId])
  @@index([transferenciaId])
  @@index([pagoEm])
  @@index([empresaId])
}

/// Centro de custo (departamento, filial, projeto) para separar resultados no financeiro e na DRE.
model CentroCusto {
  id                String             @id @default(cuid())
  empresaId         String             @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome              String
  ativo             Boolean            @default(true)
  lancamentos       Lancamento[]
  regrasConciliacao RegraConciliacao[]

  @@unique([empresaId, nome])
}

/// Divisão de um lançamento entre categorias (ex.: venda com peças e serviços): a DRE usa as frações; o lançamento continua um só (um boleto).
/**
 * Conta a receber que foi agrupada num único título (Lancamento com origemTipo AGRUPAMENTO).
 * Guarda a conta como era (para mostrar a referência à venda/OS e para desagrupar) e o documento que a gerou.
 */
model LancamentoAgrupado {
  id               String            @id @default(cuid())
  lancamentoId     String
  lancamento       Lancamento        @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  origemTipo       OrigemDocumento?
  origemId         String?
  descricao        String
  valor            Decimal           @db.Decimal(14, 2)
  vencimento       DateTime          @db.Date
  competencia      DateTime          @db.Date
  parcela          Int               @default(1)
  totalParcelas    Int               @default(1)
  categoriaId      String
  centroCustoId    String?
  formaPagamentoId String?
  observacao       String?
  idLegado         String?
  /// [{ categoriaId, fracao }] da conta original
  rateio           Json              @default("[]")
  createdAt        DateTime          @default(now())

  @@index([lancamentoId])
  @@index([origemTipo, origemId])
}

model LancamentoRateio {
  id           String              @id @default(cuid())
  lancamentoId String
  lancamento   Lancamento          @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  fracao       Decimal             @db.Decimal(9, 8)

  @@index([lancamentoId])
}

// ───────────────────────── Fiscal ─────────────────────────

enum ModeloNota {
  NFE // 55
  NFCE // 65
  NFSE // padrão nacional
}

enum StatusNota {
  RASCUNHO
  ASSINADA
  ENVIADA
  AUTORIZADA
  REJEITADA
  DENEGADA
  CANCELADA
  INUTILIZADA
}

model NotaFiscal {
  id               String           @id @default(cuid())
  cnae             String? // atividade da nota (para o imposto do Simples por CNAE): comércio = CNAE da empresa; NFS-e = CNAE do serviço
  consultadaEm     DateTime? // última consulta da situação na SEFAZ
  empresaId        String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  modelo           ModeloNota
  serie            Int
  numero           Int
  chave            String?          @unique
  status           StatusNota       @default(RASCUNHO)
  ambiente         AmbienteFiscal
  origemTipo       OrigemDocumento?
  origemId         String?
  valorTotal       Decimal          @db.Decimal(14, 2)
  xml              String? // XML assinado / autorizado (procNFe)
  protocolo        String?
  motivo           String? // cStat + xMotivo da última resposta
  emitidaEm        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  eventos          NotaEvento[]
  // nota emitida no sistema anterior (Gestão Click), trazida só para consulta: sem XML
  destinatarioNome String?
  idLegado         String?          @unique

  @@unique([empresaId, modelo, serie, numero, ambiente])
  @@index([origemTipo, origemId])
  @@index([empresaId])
}

/// Registro de auditoria: quem criou, alterou ou excluiu o quê (gravado automaticamente em src/lib/db.ts).
model RegistroAuditoria {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  usuarioId   String?
  usuarioNome String?
  ip          String?
  entidade    String // modelo do banco (Venda, OrdemServico, Lancamento…)
  entidadeId  String?
  acao        String // CRIAR | ALTERAR | EXCLUIR
  descricao   String
  campos      Json? // { campo: [antes, depois] }

  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@index([usuarioId, createdAt])
}

/// NF-e emitida por terceiros contra o CNPJ da empresa (notas de compra), baixada da SEFAZ pela distribuição DF-e.
model NotaRecebida {
  id                 String    @id @default(cuid())
  empresaId          String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  chave              String    @unique
  nsu                String?
  emitenteDocumento  String
  emitenteNome       String
  emitenteIe         String?
  emissao            DateTime
  valor              Decimal   @db.Decimal(14, 2)
  tipoNf             Int       @default(1) // 0 entrada, 1 saída (do ponto de vista do emitente)
  situacao           String    @default("AUTORIZADA") // AUTORIZADA | DENEGADA | CANCELADA
  protocolo          String?
  xml                String? // procNFe completo (vem depois da ciência da operação)
  manifestacao       String? // CIENCIA | CONFIRMADA | DESCONHECIDA | NAO_REALIZADA
  manifestadaEm      DateTime?
  protocoloManifesto String?
  justificativa      String?
  compraId           String? // compra lançada a partir desta nota
  xmlTentativas      Int       @default(0) // pedidos automáticos do XML completo depois da ciência (o agendador desiste depois de 24)
  xmlTentadoEm       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([emissao])
  @@index([empresaId])
}

/// Faixa de numeração de NF-e/NFC-e inutilizada na SEFAZ (números rejeitados ou pulados).
model InutilizacaoNumeracao {
  id            String         @id @default(cuid())
  empresaId     String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  modelo        ModeloNota
  serie         Int
  ambiente      AmbienteFiscal
  numeroInicial Int
  numeroFinal   Int
  justificativa String
  status        String // HOMOLOGADA | REJEITADA
  protocolo     String?
  motivo        String?
  xml           String?
  usuarioId     String?
  createdAt     DateTime       @default(now())

  @@index([modelo, serie, ambiente])
  @@index([empresaId])
}

model NotaEvento {
  id        String     @id @default(cuid())
  notaId    String
  nota      NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tipo      String // 110111 cancelamento, 110110 CC-e...
  sequencia Int        @default(1)
  texto     String? // correção da CC-e / justificativa
  xml       String?
  protocolo String?
  createdAt DateTime   @default(now())
}

/// Contadores de numeração (OS, venda, compra, NF por série...).
model Sequencia {
  chave String @id
  valor Int    @default(0)
}

/**
 * Linha do extrato bancário importado (OFX/CSV), casada com um lançamento na conciliação.
 */
model TransacaoBancaria {
  id                   String              @id @default(cuid())
  contaBancariaId      String
  contaBancaria        ContaBancaria       @relation(fields: [contaBancariaId], references: [id])
  data                 DateTime            @db.Date
  valor                Decimal             @db.Decimal(14, 2) // positivo = entrada, negativo = saída
  descricao            String
  documento            String?
  chave                String // FITID do OFX ou hash da linha do CSV
  dataHora             DateTime? // data e hora do lançamento no banco, quando o extrato traz (ordena a conciliação)
  contraparteDocumento String? // CPF/CNPJ de quem pagou/recebeu, quando o banco manda (Inter: detalhes da transação)
  situacao             SituacaoConciliacao @default(PENDENTE)
  motivo               String? // BOLETO_INTER: boleto recebido, baixado pela cobrança do Inter (sai sozinho da conciliação); REABERTA: a pessoa voltou para pendente
  lancamentos          Lancamento[]
  createdAt            DateTime            @default(now())

  @@unique([contaBancariaId, chave])
  @@index([situacao])
}

/// O que fazer com um favorecido do extrato: aprendida ao confirmar um lançamento avulso ou criada na tela de regras.
model RegraConciliacao {
  id            String              @id @default(cuid())
  empresaId     String              @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  texto         String // favorecido lido do extrato (IGUAL) ou trecho da descrição (CONTEM), sem acento e em minúsculas
  modo          String              @default("IGUAL") // IGUAL | CONTEM
  tipo          TipoLancamento
  categoriaId   String
  categoria     CategoriaFinanceira @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  centroCustoId String?
  centroCusto   CentroCusto?        @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)
  descricao     String? // descrição do lançamento (vazio = a do extrato)
  origem        String              @default("APRENDIDA") // APRENDIDA | MANUAL
  ativa         Boolean             @default(true)
  vezes         Int                 @default(0) // confirmações que seguiram a regra
  ultimaEm      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([empresaId, texto, modo, tipo])
}

/// Saldo informado pelo banco (Inter na sincronização) ou digitado, para conferir com o saldo do sistema.
model SaldoBancario {
  id              String        @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
  data            DateTime      @db.Date
  saldo           Decimal       @db.Decimal(14, 2)
  origem          String // INTER | MANUAL
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([contaBancariaId, data, origem])
}

enum SituacaoConciliacao {
  PENDENTE
  CONCILIADA
  IGNORADA
}

// ───────────────────────── Orçamentos ─────────────────────────

enum TipoOrcamento {
  PRODUTO
  SERVICO
}

/// Situações configuráveis (Em aberto, Em andamento, Concretizado, Cancelado…), na ordem da lista.
model SituacaoOrcamento {
  id               String         @id @default(cuid())
  empresaId        String         @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  nome             String
  cor              String         @default("cinza")
  exibir           Boolean        @default(true) // aparece na listagem
  ordem            Int            @default(0)
  geraVenda        Boolean        @default(false) // sugere gerar venda ao entrar nesta situação
  enviarMensagem   Boolean        @default(false)
  modeloMensagemId String?
  gerarAssinatura  Boolean        @default(false)
  bloqueados       PapelUsuario[] // grupos que não podem trocar a situação
  orcamentos       Orcamento[]

  @@unique([empresaId, nome])
}

model Orcamento {
  id                 String            @id @default(cuid())
  numero             Int               @unique
  tipo               TipoOrcamento     @default(PRODUTO)
  clienteId          String
  cliente            Pessoa            @relation("OrcamentoCliente", fields: [clienteId], references: [id])
  vendedorId         String?
  vendedor           Usuario?          @relation("OrcamentoVendedor", fields: [vendedorId], references: [id])
  data               DateTime          @db.Date
  validade           String?
  prazoEntrega       DateTime?         @db.Date
  aosCuidados        String?
  canal              String            @default("Presencial")
  centroCusto        String?
  introducao         String?
  situacaoId         String
  situacao           SituacaoOrcamento @relation(fields: [situacaoId], references: [id])
  transportadoraId   String?
  transportadora     Pessoa?           @relation("OrcamentoTransportadora", fields: [transportadoraId], references: [id])
  frete              Decimal           @default(0) @db.Decimal(14, 2)
  mostrarEntrega     Boolean           @default(false)
  enderecoEntregaId  String?
  totalProdutos      Decimal           @default(0) @db.Decimal(14, 2)
  totalServicos      Decimal           @default(0) @db.Decimal(14, 2)
  desconto           Decimal           @default(0) @db.Decimal(14, 2)
  descontoPercentual Decimal?          @db.Decimal(7, 4)
  total              Decimal           @default(0) @db.Decimal(14, 2)
  exibirTotal        Boolean           @default(true)
  gerarCondicoes     Boolean           @default(true)
  condicao           String            @default("AVISTA") // AVISTA | PARCELADO
  formaPagamentoId   String?
  formaPagamento     FormaPagamento?   @relation(fields: [formaPagamentoId], references: [id])
  intervaloDias      Int               @default(30)
  observacoes        String?
  observacaoInterna  String?
  camposExtras       Json?
  token              String            @unique @default(cuid()) // link público da proposta
  empresaId          String?
  vendaId            String?
  osId               String?
  criadoPorId        String?
  idLegado           String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  produtos  OrcamentoItem[]
  servicos  OrcamentoServico[]
  parcelas  OrcamentoParcela[]
  historico OrcamentoHistorico[]

  @@index([data])
  @@index([clienteId])
  @@index([empresaId])
}

model OrcamentoItem {
  id          String    @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  ordem       Int       @default(0)
  produtoId   String
  produto     Produto   @relation(fields: [produtoId], references: [id])
  descricao   String? // item avulso: descrição digitada (produto = ITEM-AVULSO)
  detalhes    String?
  quantidade  Decimal   @db.Decimal(14, 4)
  tipoValorId String?
  valorUnit   Decimal   @db.Decimal(14, 2)
  desconto    Decimal   @default(0) @db.Decimal(14, 2)
  subtotal    Decimal   @db.Decimal(14, 2)
}

model OrcamentoServico {
  id          String    @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  ordem       Int       @default(0)
  servicoId   String
  servico     Servico   @relation(fields: [servicoId], references: [id])
  detalhes    String?
  quantidade  Decimal   @default(1) @db.Decimal(14, 4)
  valorUnit   Decimal   @db.Decimal(14, 2)
  desconto    Decimal   @default(0) @db.Decimal(14, 2)
  subtotal    Decimal   @db.Decimal(14, 2)
}

model OrcamentoParcela {
  id               String          @id @default(cuid())
  orcamentoId      String
  orcamento        Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  numero           Int
  vencimento       DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  observacao       String?
}

model OrcamentoHistorico {
  id          String    @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  descricao   String
  situacao    String?
  usuarioNome String?
  createdAt   DateTime  @default(now())
}

/// Anotações de qualquer registro (orçamento, venda, OS…).
model Anotacao {
  id         String   @id @default(cuid())
  entidade   String
  entidadeId String
  texto      String
  usuarioId  String?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
}

/// Modelos de mensagem (e-mail, SMS, WhatsApp) por módulo: OR = orçamento, VE = venda, OS.
model ModeloMensagem {
  id        String  @id @default(cuid())
  empresaId String  @default("") // empresa dona ("" = a principal, a primeira cadastrada)
  tipo      String
  assunto   String
  padrao    Boolean @default(false)
  email     String
  sms       String?
  whatsapp  String? // texto do WhatsApp (MXChat); vazio = gerado a partir do e-mail

  @@index([empresaId])
}

/// Configurações gerais por chave (textos padrão, formato de impressão, o que aparece nos documentos).
model Configuracao {
  chave String @id
  valor Json
}

// ───────────────────────── Contratos (serviços recorrentes) ─────────────────────────

enum SituacaoContrato {
  EM_ABERTO // cadastrado, ainda não cobra
  ATIVO // gera as cobranças
  PAUSADO
  FINALIZADO
  CANCELADO
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/**
 * Contrato com o cliente (no Gestão Click, "Assinatura"): serviços cobrados de tempos em tempos.
 * A cada vencimento gera uma venda de serviços (financeiro + boleto do Inter), opcionalmente a NFS-e,
 * e manda o boleto e o lembrete de pagamento por e-mail nos dias configurados.
 */
model Contrato {
  id                 String              @id @default(cuid())
  empresaId          String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero             Int                 @unique
  clienteId          String
  cliente            Pessoa              @relation(fields: [clienteId], references: [id])
  vendedorId         String?
  vendedor           Usuario?            @relation(fields: [vendedorId], references: [id])
  situacao           SituacaoContrato    @default(ATIVO)
  canal              String              @default("Presencial")
  centroCusto        String?
  dataInicio         DateTime            @db.Date
  periodicidade      Periodicidade       @default(MENSAL)
  diaVencimento      Int // 1 a 31 (meses mais curtos usam o último dia)
  proximoVencimento  DateTime            @db.Date
  termino            String              @default("SEM") // SEM | DATA | VEZES
  dataFim            DateTime?           @db.Date
  totalCobrancas     Int?
  cobrancasGeradas   Int                 @default(0)
  totalServicos      Decimal             @default(0) @db.Decimal(14, 2)
  desconto           Decimal             @default(0) @db.Decimal(14, 2)
  descontoPercentual Decimal?            @db.Decimal(7, 4)
  total              Decimal             @default(0) @db.Decimal(14, 2) // valor de cada cobrança
  formaPagamentoId   String?
  formaPagamento     FormaPagamento?     @relation(fields: [formaPagamentoId], references: [id])
  diasAntecedencia   Int                 @default(10) // gera a venda e manda o boleto N dias antes do vencimento
  enviarBoleto       Boolean             @default(true)
  diasLembrete       Int? // lembrete de pagamento N dias antes do vencimento (vazio = não manda)
  emitirNota         Boolean             @default(false) // emite a NFS-e da venda gerada
  emailCobranca      String? // e-mail para a cobrança (vazio = e-mail do cliente)
  canalEmail         Boolean             @default(true) // cobrança e lembrete por e-mail
  canalWhatsapp      Boolean             @default(false) // cobrança e lembrete por WhatsApp (MXChat)
  whatsappCobranca   String? // número para o WhatsApp (vazio = celular do cliente)
  observacoes        String? // vai na venda gerada
  observacaoInterna  String?
  criadoPorId        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  servicos           ContratoServico[]
  cobrancas          ContratoCobranca[]
  historico          ContratoHistorico[]
  idLegado           String?             @unique // serviço recorrente do Gestão Click

  @@index([situacao, proximoVencimento])
  @@index([empresaId])
}

model ContratoServico {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id])
  ordem      Int      @default(0)
  detalhes   String?
  quantidade Decimal  @default(1) @db.Decimal(14, 4)
  valorUnit  Decimal  @db.Decimal(14, 2)
  desconto   Decimal  @default(0) @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)
}

/// Uma cobrança (vencimento) do contrato e o que já foi feito com ela: venda, nota, e-mails.
model ContratoCobranca {
  id                String    @id @default(cuid())
  contratoId        String
  contrato          Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero            Int // 1ª, 2ª... cobrança do contrato
  vencimento        DateTime  @db.Date
  referencia        String // ex.: "12/2026" ou "12/2026 a 02/2027"
  situacao          String    @default("PENDENTE") // PENDENTE | GERANDO | GERADA | ERRO
  erro              String?
  vendaId           String?   @unique
  notaMsg           String? // resultado da NFS-e automática
  notaTentadaEm     DateTime?
  boletoEnviadoEm   DateTime?
  lembreteEnviadoEm DateTime?
  boletoWhatsEm     DateTime? // cobrança mandada por WhatsApp
  lembreteWhatsEm   DateTime?
  envioErro         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([contratoId, vencimento])
  @@index([situacao])
}

model ContratoHistorico {
  id          String   @id @default(cuid())
  contratoId  String
  contrato    Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  descricao   String
  usuarioNome String?
  createdAt   DateTime @default(now())
}

/// Boleto pago no Inter sem conta a receber correspondente em aberto no sistema (precisa de alguém olhar).
model AvisoBoleto {
  id                String      @id @default(cuid())
  codigoSolicitacao String      @unique
  boletoId          String?
  /// NAO_EMITIDO (boleto não foi gerado pelo MXERP), SEM_CONTA (a conta foi excluída), CONTA_JA_PAGA (possível pagamento em dobro)
  motivo            String
  seuNumero         String?
  nossoNumero       String?
  pagadorNome       String?
  pagadorDocumento  String?
  valor             Decimal?    @db.Decimal(14, 2)
  valorRecebido     Decimal?    @db.Decimal(14, 2)
  pagoEm            DateTime?   @db.Date
  origemRecebimento String?
  /// a conta envolvida (a que já estava paga, ou a que foi lançada/baixada ao resolver)
  lancamentoId      String?
  lancamento        Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  resolvidoEm       DateTime?
  resolvidoPor      String?
  resolucao         String?
  createdAt         DateTime    @default(now())

  @@index([resolvidoEm])
}

/// Permissão por ação configurada na tela (sobrepõe o padrão do catálogo em src/lib/auth/permissoesAcao.ts). ADMIN sempre pode tudo.
model PermissaoPapel {
  id        String       @id @default(cuid())
  papel     PapelUsuario
  acao      String
  permitido Boolean
  updatedAt DateTime     @updatedAt

  @@unique([papel, acao])
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum PrioridadeChamado {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

/// Atendimento / chamado de suporte (helpdesk): pedido do cliente com responsável, prazo e histórico.
model Chamado {
  id                 String             @id @default(cuid())
  empresaId          String? // loja (CNPJ) dona do registro; ver src/lib/empresa/loja.ts
  numero             Int                @unique
  clienteId          String?
  cliente            Pessoa?            @relation(fields: [clienteId], references: [id])
  contato            String?
  telefone           String?
  assunto            String
  descricao          String?
  canal              String             @default("TELEFONE") // TELEFONE, WHATSAPP, EMAIL, PRESENCIAL, SITE, OUTRO
  categoria          String?
  prioridade         PrioridadeChamado  @default(NORMAL)
  status             StatusChamado      @default(ABERTO)
  responsavelId      String?
  responsavel        Usuario?           @relation("ChamadoResponsavel", fields: [responsavelId], references: [id])
  abertoPorId        String?
  abertoPor          Usuario?           @relation("ChamadoAbertoPor", fields: [abertoPorId], references: [id])
  prazo              DateTime?
  osId               String?
  os                 OrdemServico?      @relation(fields: [osId], references: [id], onDelete: SetNull)
  primeiraRespostaEm DateTime?
  resolvidoEm        DateTime?
  solucao            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  interacoes         ChamadoInteracao[]

  @@index([status])
  @@index([clienteId])
  @@index([responsavelId, status])
  @@index([empresaId])
}

/// Linha do histórico do chamado: comentário, mudança de status, troca de responsável.
model ChamadoInteracao {
  id          String   @id @default(cuid())
  chamadoId   String
  chamado     Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  usuarioId   String?
  usuarioNome String?
  tipo        String   @default("COMENTARIO") // COMENTARIO, STATUS, RESPONSAVEL, ABERTURA
  texto       String
  interno     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([chamadoId, createdAt])
}

/// Alíquota efetiva do Simples Nacional por CNAE e mês, como o contador informa (imposto aproximado das notas).
/// cnae "*" vale para as atividades que não têm alíquota própria no mês.
model AliquotaSimples {
  id          String   @id @default(cuid())
  empresaId   String
  competencia String // AAAA-MM
  cnae        String
  descricao   String?
  aliquota    Decimal  @db.Decimal(7, 4) // em %, ex.: 10.8800
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empresaId, competencia, cnae])
}

/// Histórico de mensagens de WhatsApp mandadas pelo MXChat (OS, cobranças dos contratos, testes).
model MensagemWhatsapp {
  id          String   @id @default(cuid())
  numero      String // 55DDDNUMERO
  texto       String
  arquivoNome String? // anexo (ex.: boleto em PDF)
  entidade    String // OS | CONTRATO | TESTE
  entidadeId  String?
  pessoaId    String?
  situacao    String // ENVIADA | ERRO
  erro        String?
  automatica  Boolean  @default(false) // mandada pelo sistema (situação da OS, rotina dos contratos)
  usuarioNome String?
  empresaId   String? // loja (CNPJ) que mandou; ver src/lib/empresa/loja.ts
  createdAt   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@index([empresaId])
}

/// Etiqueta de frete comprada no Melhor Envio para uma venda (uma venda pode ter mais de uma: reenvio, cancelada).
model EnvioFrete {
  id             String    @id @default(cuid())
  vendaId        String
  venda          Venda     @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  empresaId      String?
  servicoId      Int // id do serviço no Melhor Envio (1 = PAC, 2 = SEDEX, 3 = Jadlog .Package…)
  servicoNome    String
  transportadora String // Correios, Jadlog, Loggi…
  valor          Decimal   @db.Decimal(14, 2) // custo da etiqueta no Melhor Envio
  prazoDias      Int?
  volumes        Json      @default("[]")
  situacao       String    @default("CARRINHO") // CARRINHO | PAGA | GERADA | POSTADA | ENTREGUE | NAO_ENTREGUE | CANCELADA | ERRO
  meId           String?   @unique // id da etiqueta (order) no Melhor Envio
  protocolo      String?
  rastreio       String? // código da transportadora
  rastreioMe     String? // código do Melhor Rastreio
  erro           String?
  pagaEm         DateTime?
  geradaEm       DateTime?
  postadaEm      DateTime?
  entregueEm     DateTime?
  canceladaEm    DateTime?
  consultadaEm   DateTime?
  usuarioNome    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendaId])
  @@index([situacao])
}

/// PIX dinâmico gerado no PDV pelo PagSeguro (API de pedidos). A venda só fecha depois de PAGA.
model CobrancaPix {
  id        String    @id @default(cuid())
  pedidoId  String    @unique // ORDE_… no PagSeguro
  qrId      String?
  texto     String // PIX copia e cola
  valor     Decimal   @db.Decimal(14, 2)
  situacao  String    @default("PENDENTE") // PENDENTE | PAGA | CANCELADA | EXPIRADA
  vendaId   String?   @unique
  caixaId   String?
  usuarioId String?
  expiraEm  DateTime
  pagaEm    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Linha do extrato EDI do PagSeguro (uma por parcela de cada venda na maquininha ou PIX), ligada à conta a receber.
model TransacaoPagSeguro {
  id               String    @id @default(cuid())
  codigo           String // codigo_transacao
  parcela          Int       @default(1)
  totalParcelas    Int       @default(1)
  dataVenda        DateTime
  meio             String // CREDITO | DEBITO | PIX | OUTRO
  valorBruto       Decimal   @db.Decimal(14, 2) // valor da parcela
  taxa             Decimal   @default(0) @db.Decimal(14, 2)
  valorLiquido     Decimal   @db.Decimal(14, 2)
  dataPrevista     DateTime? @db.Date
  pagaEm           DateTime? @db.Date
  nsu              String?
  cartao           String? // bandeira/final
  situacao         String    @default("SEM_CONTA") // SEM_CONTA | CONCILIADA | RECEBIDA | IGNORADA
  lancamentoId     String?   @unique
  taxaLancamentoId String?
  dados            Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([codigo, parcela])
  @@index([situacao])
  @@index([dataVenda])
}

/// Pacote do mês mandado ao contador (XMLs emitidos e recebidos + resumo), um por CNPJ e competência.
model EnvioContador {
  id            String   @id @default(cuid())
  empresaId     String
  competencia   String // AAAA-MM
  situacao      String // ENVIADO | ERRO
  destinatarios String
  arquivos      Int      @default(0)
  tamanho       Int      @default(0) // bytes do .zip
  token         String   @unique @default(cuid()) // link de download para o contador
  erro          String?
  automatico    Boolean  @default(false)
  usuarioNome   String?
  createdAt     DateTime @default(now())

  @@index([empresaId, competencia])
}

// ---------- marketplaces (Mercado Livre primeiro; Shopee, Amazon e Magalu depois)

/// Conta conectada de um marketplace. id = canal ("MERCADO_LIVRE"). Segredos e tokens cifrados (src/lib/seguranca/segredos.ts).
model IntegracaoMarketplace {
  id                  String    @id
  ativo               Boolean   @default(true)
  clientId            String
  clientSecretCifrado String
  redirectUri         String
  accessTokenCifrado  String?
  refreshTokenCifrado String?
  tokenExpiraEm       DateTime?
  estadoOauth         String? // "state" do link de autorização em andamento
  contaId             String? // id do vendedor no marketplace
  contaNome           String? // apelido da conta
  empresaId           String? // loja (CNPJ) das vendas geradas
  contaBancariaId     String? // conta do financeiro onde o dinheiro é liberado (padrão "Mercado Pago")
  situacaoVendaId     String? // situação das vendas geradas (padrão: a que lança estoque e financeiro)
  formaPagamentoId    String? // forma das contas a receber (padrão "Mercado Pago")
  canalVenda          String    @default("Mercado Livre")
  importarDesde       DateTime? // pedidos criados antes disto não viram venda (já lançados à mão)
  cancelarAuto        Boolean   @default(true) // pedido cancelado no marketplace cancela a venda (se o dinheiro não foi liberado)
  sincronizarAuto     Boolean   @default(true)
  webhookToken        String?
  ultimaSincEm        DateTime?
  ultimaSincMsg       String?
  atualizadoEm        DateTime  @updatedAt
}

/// Pedido vindo de um marketplace: vira venda (estoque + conta a receber) e é baixado quando o dinheiro é liberado.
model PedidoMarketplace {
  id                 String    @id @default(cuid())
  empresaId          String? // loja (CNPJ) da integração; ver src/lib/empresa/loja.ts
  canal              String // MERCADO_LIVRE
  externoId          String // nº do pedido no marketplace
  pacoteId           String? // carrinho (pack) do Mercado Livre
  situacaoExterna    String // status no marketplace (paid, cancelled…)
  etapa              String // AGUARDANDO_PAGAMENTO | SEM_VINCULO | AGUARDANDO_LIBERACAO | LIBERADO | CANCELADO | IGNORADO | ERRO
  dataPedido         DateTime
  compradorNome      String?
  compradorApelido   String?
  compradorDocumento String?
  total              Decimal   @db.Decimal(14, 2) // valor dos itens
  bruto              Decimal?  @db.Decimal(14, 2) // pago pelo comprador (itens + frete)
  liquido            Decimal?  @db.Decimal(14, 2) // recebido pelo vendedor
  tarifa             Decimal?  @db.Decimal(14, 2) // total − líquido (comissão, taxa do Mercado Pago, frete cobrado)
  pagamentos         Json      @default("[]")
  liberacaoPrevista  DateTime?
  liberadoEm         DateTime?
  vendaId            String?   @unique
  lancamentoTarifaId String?
  erro               String?
  dados              Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([canal, externoId])
  @@index([etapa])
  @@index([dataPedido])
  @@index([empresaId])
}

/// Anúncio (e variação) do marketplace ligado a um produto do MXERP. Preenchido sozinho pelo SKU; o que não casar é ligado na tela.
model AnuncioMarketplace {
  id         String   @id @default(cuid())
  canal      String
  anuncioId  String
  variacaoId String   @default("")
  titulo     String
  sku        String?
  produtoId  String?
  produto    Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([canal, anuncioId, variacaoId])
}

/// Quem aparece no extrato (nome normalizado tirado da descrição) e o ramo de atividade dele, para a conciliação
/// sugerir a categoria das despesas. O CNAE vem da consulta do CNPJ (BrasilAPI/CNPJ.ws/ReceitaWS).
model FavorecidoExtrato {
  chave        String    @id // favorecido(descricao)
  documento    String? // CNPJ/CPF só dígitos
  cnae         String? // CNAE fiscal principal, só dígitos
  razaoSocial  String?
  consultadoEm DateTime?
  erro         String?
  updatedAt    DateTime  @updatedAt
}
