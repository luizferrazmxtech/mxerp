# Copie para .env (o instalar.ps1 do Windows já faz isso e gera as senhas)

# Senha do banco de dados (gerada na instalação; não precisa decorar)
DB_SENHA=
# Porta do sistema no computador (http://localhost:3000)
PORTA=3000
# Senha do agendador interno (gerada na instalação)
CRON_SECRET=

# Só para desenvolvimento sem Docker: aponte para o seu PostgreSQL
# DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/mxerp?schema=public"

# Certificado digital A1 para NF-e, NFC-e e NFS-e: coloque o .pfx na pasta certificados
CERTIFICADO_A1_PATH=/certificados/certificado.pfx
CERTIFICADO_A1_SENHA=

# Banco Inter (API PJ): configure pela tela Financeiro -> Conciliacao -> Configurar Banco Inter.
# O client secret e a chave .key ficam cifrados no banco com a chave abaixo (se vazia, usa o CRON_SECRET).
# Se trocar essa chave (ou o CRON_SECRET), salve as credenciais do Inter de novo na tela.
CHAVE_SEGREDOS=
